<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Administración de usuarios (RF-SEG-03), solo ADMIN -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.odontogest.ui.controlador.UsuariosController" spacing="12">
    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Un usuario con rol Odontólogo se vincula a un odontólogo del catálogo." styleClass="text-muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnRestablecer" text="Restablecer contraseña" onAction="#onRestablecer">
            <graphic><FontIcon iconLiteral="fth-unlock"/></graphic>
        </Button>
        <Button fx:id="btnEditar" text="Editar" onAction="#onEditar">
            <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
        </Button>
        <Button text="Nuevo usuario" styleClass="accent" onAction="#onNuevo">
            <graphic><FontIcon iconLiteral="fth-user-plus"/></graphic>
        </Button>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Sin usuarios."/></placeholder>
    </TableView>
</VBox>
