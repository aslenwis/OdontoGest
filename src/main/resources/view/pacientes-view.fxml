<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.CustomTextField?>
<?import com.odontogest.ui.componente.Paginador?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.odontogest.ui.controlador.PacientesController" spacing="12">
    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <CustomTextField fx:id="txtBuscar" promptText="Buscar por nombre, documento o N° de historia" prefWidth="420">
            <left><FontIcon iconLiteral="fth-search"/></left>
        </CustomTextField>
        <CheckBox fx:id="chkInactivos" text="Incluir inactivos"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAbrir" text="Abrir ficha" onAction="#onAbrir">
            <graphic><FontIcon iconLiteral="fth-folder"/></graphic>
        </Button>
        <Button fx:id="btnNuevo" text="Nuevo paciente" styleClass="accent" onAction="#onNuevo">
            <graphic><FontIcon iconLiteral="fth-user-plus"/></graphic>
        </Button>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <placeholder><Label text="No hay pacientes que coincidan con la búsqueda."/></placeholder>
    </TableView>

    <Paginador fx:id="paginador"/>
</VBox>
