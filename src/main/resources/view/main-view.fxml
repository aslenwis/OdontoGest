<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ModalPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.odontogest.ui.controlador.MainController">

    <BorderPane>
        <left>
            <VBox styleClass="sidebar" prefWidth="230" spacing="8">
                <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>

                <Label text="OdontoGest" styleClass="title-3, sidebar-marca">
                    <graphic><FontIcon iconLiteral="fth-activity" iconSize="22" styleClass="login-icono"/></graphic>
                </Label>
                <Separator/>

                <!-- Lo llena MainController según los permisos del usuario -->
                <VBox fx:id="menu" spacing="4" VBox.vgrow="ALWAYS"/>

                <Separator/>
                <Button fx:id="btnTema" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="flat"
                        onAction="#onAlternarTema"/>
            </VBox>
        </left>

        <top>
            <HBox styleClass="barra-superior" alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="10" right="16" bottom="10" left="20"/></padding>
                <Label fx:id="lblTitulo" text="Inicio" styleClass="title-4"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblSinInternet" text="Sin internet: DNI y correo no disponibles" styleClass="etiqueta-aviso"
                       visible="false" managed="false">
                    <graphic><FontIcon iconLiteral="fth-wifi-off"/></graphic>
                </Label>
                <FontIcon iconLiteral="fth-user" iconSize="18"/>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="lblUsuario" styleClass="text-bold"/>
                    <Label fx:id="lblRol" styleClass="text-muted, text-small"/>
                </VBox>
                <Button styleClass="flat, button-icon" onAction="#onAcercaDe">
                    <graphic><FontIcon iconLiteral="fth-info"/></graphic>
                    <tooltip><Tooltip text="Acerca de OdontoGest"/></tooltip>
                </Button>
                <Button text="Contraseña" styleClass="flat" onAction="#onCambiarPassword">
                    <graphic><FontIcon iconLiteral="fth-key"/></graphic>
                </Button>
                <Button text="Cerrar sesión" styleClass="flat" onAction="#onCerrarSesion">
                    <graphic><FontIcon iconLiteral="fth-log-out"/></graphic>
                </Button>
            </HBox>
        </top>

        <center>
            <!-- MainController muestra aquí el tablero de inicio y las demás vistas del menú -->
            <StackPane fx:id="contenido" styleClass="contenido"/>
        </center>
    </BorderPane>

    <VBox fx:id="zonaToasts" spacing="8" maxWidth="380" maxHeight="-Infinity" pickOnBounds="false"
          StackPane.alignment="TOP_RIGHT">
        <StackPane.margin><Insets top="64" right="16"/></StackPane.margin>
    </VBox>

    <ModalPane fx:id="modal"/>
</StackPane>
