<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<SplitPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.odontogest.ui.controlador.AtencionesControllerASEJ" dividerPositions="0.32">
    <VBox spacing="8" minWidth="260">
        <padding><Insets top="12" right="10" bottom="12" left="12"/></padding>
        <Button fx:id="btnNuevaASEJ" text="Nueva atención" styleClass="accent" maxWidth="Infinity" onAction="#onNuevaASEJ">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
        <ListView fx:id="lstAtencionesASEJ" VBox.vgrow="ALWAYS" styleClass="lista-ajustable"/>
    </VBox>
    <BorderPane>
    <center>
    <ScrollPane fitToWidth="true" styleClass="edge-to-edge">
        <VBox fx:id="panelDetalleASEJ" spacing="10">
            <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
            <Label fx:id="lblTituloASEJ" styleClass="title-4"/>
            <Label fx:id="lblDetalleASEJ" styleClass="text-muted"/>
            <Label text="Motivo de consulta *" styleClass="text-bold"/>
            <TextArea fx:id="txtMotivoASEJ" prefRowCount="2" wrapText="true"/>
            <Label text="Examen clínico" styleClass="text-bold"/>
            <TextArea fx:id="txtExamenASEJ" prefRowCount="3" wrapText="true"/>
            <Label text="Diagnóstico" styleClass="text-bold"/>
            <TextArea fx:id="txtDiagnosticoASEJ" prefRowCount="3" wrapText="true"/>
            <Label text="Observaciones" styleClass="text-bold"/>
            <TextArea fx:id="txtObservacionesASEJ" prefRowCount="2" wrapText="true"/>
            <Label text="Procedimientos del plan realizados en esta atención" styleClass="text-bold"/>
            <Label fx:id="lblItemsASEJ" styleClass="text-muted, text-small" wrapText="true"/>
            <VBox fx:id="boxItemsASEJ" spacing="6"/>
        </VBox>
    </ScrollPane>
    </center>
    <bottom>
            <HBox fx:id="barraAcciones" spacing="8" alignment="CENTER_LEFT" styleClass="barra-acciones">
                <padding><Insets top="8" right="18" bottom="8" left="18"/></padding>
                <Button fx:id="btnOdontogramaASEJ" text="Ir al odontograma" onAction="#onIrOdontogramaASEJ">
                    <graphic><FontIcon iconLiteral="fth-grid"/></graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCerrarASEJ" text="Cerrar atención" onAction="#onCerrarASEJ">
                    <graphic><FontIcon iconLiteral="fth-lock"/></graphic>
                </Button>
                <Button fx:id="btnGuardarASEJ" text="Guardar" styleClass="accent" onAction="#onGuardarASEJ">
                    <graphic><FontIcon iconLiteral="fth-save"/></graphic>
                </Button>
            </HBox>
    </bottom>
    </BorderPane>
</SplitPane>
