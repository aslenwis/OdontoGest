<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.odontogest.ui.controlador.AcercaDeControllerASEJ" spacing="12" prefWidth="640"
      styleClass="acerca-de">
    <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <FontIcon iconLiteral="fth-activity" iconSize="44" styleClass="login-icono"/>
        <VBox>
            <Label fx:id="lblNombreASEJ" styleClass="title-2"/>
            <Label fx:id="lblDescripcionASEJ" styleClass="text-muted" wrapText="true"/>
        </VBox>
    </HBox>

    <GridPane hgap="14" vgap="6">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Versión" styleClass="text-muted" GridPane.rowIndex="0"/>
        <Label fx:id="lblVersionASEJ" styleClass="text-bold" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Autores" styleClass="text-muted" GridPane.rowIndex="1" GridPane.valignment="TOP"/>
        <VBox fx:id="boxAutoresASEJ" spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Curso" styleClass="text-muted" GridPane.rowIndex="2"/>
        <Label fx:id="lblCursoASEJ" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Universidad" styleClass="text-muted" GridPane.rowIndex="3"/>
        <Label fx:id="lblUniversidadASEJ" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Año" styleClass="text-muted" GridPane.rowIndex="4"/>
        <Label fx:id="lblAnioASEJ" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label text="Java" styleClass="text-muted" GridPane.rowIndex="5"/>
        <Label fx:id="lblJavaASEJ" styleClass="text-small" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>

    <Label fx:id="lblAvisoASEJ" wrapText="true" minHeight="-Infinity" styleClass="text-small, text-muted"/>
    <Separator/>

    <GridPane hgap="14" vgap="4">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Datos" styleClass="text-muted" GridPane.rowIndex="0"/>
        <Hyperlink fx:id="lnkDatosASEJ" onAction="#onAbrirDatosASEJ" wrapText="true" minHeight="-Infinity"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Base de datos" styleClass="text-muted" GridPane.rowIndex="1"/>
        <Label fx:id="lblBaseASEJ" styleClass="text-small" wrapText="true" minHeight="-Infinity"
               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Registro (log)" styleClass="text-muted" GridPane.rowIndex="2"/>
        <Hyperlink fx:id="lnkLogsASEJ" onAction="#onAbrirLogsASEJ" wrapText="true" minHeight="-Infinity"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <Label fx:id="lblIntegridadASEJ" wrapText="true" minHeight="-Infinity" visible="false" managed="false"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnVerificarASEJ" text="Verificar integridad de la base de datos" minWidth="-Infinity"
                onAction="#onVerificarASEJ">
            <graphic><FontIcon iconLiteral="fth-shield"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCerrarASEJ" text="Cerrar" cancelButton="true" defaultButton="true" minWidth="-Infinity"
                onAction="#onCerrarASEJ"/>
    </HBox>
</VBox>
