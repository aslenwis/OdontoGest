<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Catálogo de hallazgos del odontograma (RF-CAT-02) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.odontogest.ui.controlador.HallazgosTabController" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Validar siglas, símbolos y colores contra el Anexo de la NTS N° 188-MINSA/DGIESP-2022." styleClass="text-muted" wrapText="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="chkInactivos" text="Incluir inactivos"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#onEditar">
            <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
        </Button>
        <Button text="Nuevo tipo" styleClass="accent" onAction="#onNuevo">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Sin registros."/></placeholder>
    </TableView>
</VBox>
