<?xml version="1.0" encoding="UTF-8"?>

<?import com.odontogest.ui.componente.OdontogramaCanvas?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Pestaña Odontograma (PLAN §6.2): línea de tiempo arriba, paleta a la izquierda, lienzo al centro,
     inspector a la derecha y especificaciones/índices abajo. -->
<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.odontogest.ui.controlador.OdontogramaController">
    <top>
        <ToolBar>
            <ComboBox fx:id="cmbMomento" prefWidth="200" promptText="Sin odontograma"/>
            <Slider fx:id="sldLinea" prefWidth="100" min="0" max="0" majorTickUnit="1" minorTickCount="0"
                    snapToTicks="true" showTickMarks="true"/>
            <Separator/>
            <Label text="Dentición"/>
            <RadioButton fx:id="rbPermanente" text="Permanente"/>
            <RadioButton fx:id="rbDecidua" text="Decidua"/>
            <RadioButton fx:id="rbMixta" text="Mixta"/>
            <Separator/>
            <ToggleButton fx:id="tglComparar" text="Comparar con inicial">
                <graphic><FontIcon iconLiteral="fth-git-pull-request"/></graphic>
            </ToggleButton>
            <Button fx:id="btnCerrar" text="Cerrar y firmar" onAction="#onCerrar">
                <graphic><FontIcon iconLiteral="fth-lock"/></graphic>
            </Button>
            <Button fx:id="btnNuevaEvolucion" text="Nueva evolución" onAction="#onNuevaEvolucion">
                <graphic><FontIcon iconLiteral="fth-plus-circle"/></graphic>
            </Button>
            <Button fx:id="btnPdf" text="PDF" onAction="#onPdf">
                <graphic><FontIcon iconLiteral="fth-printer"/></graphic>
            </Button>
        </ToolBar>
    </top>

    <left>
        <VBox spacing="8" prefWidth="250" styleClass="odontograma-panel">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Button fx:id="btnSeleccion" text="Modo selección (Esc)" maxWidth="Infinity" onAction="#onModoSeleccion">
                <graphic><FontIcon iconLiteral="fth-mouse-pointer"/></graphic>
            </Button>
            <Accordion fx:id="paleta" VBox.vgrow="ALWAYS"/>
            <Separator/>
            <Label text="Estado del hallazgo" styleClass="text-bold"/>
            <HBox spacing="12">
                <RadioButton fx:id="rbBueno" text="Bueno (B)"/>
                <RadioButton fx:id="rbMalo" text="Malo (M)"/>
            </HBox>
            <Label fx:id="lblPendiente" wrapText="true" styleClass="text-muted, text-small"/>
            <Button fx:id="btnRegistrar" text="Registrar (Enter)" maxWidth="Infinity" styleClass="accent" onAction="#onRegistrar">
                <graphic><FontIcon iconLiteral="fth-check"/></graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <StackPane>
            <OdontogramaCanvas fx:id="lienzo"/>
            <VBox fx:id="panelVacio" alignment="CENTER" spacing="10" maxWidth="420" maxHeight="-Infinity"
                  styleClass="tarjeta" StackPane.alignment="CENTER">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                <Label text="El paciente aún no tiene odontograma" styleClass="text-bold"/>
                <Label text="Abra una atención para registrar el odontograma inicial." wrapText="true" styleClass="text-muted"/>
                <Button fx:id="btnNuevaAtencion" text="Nueva atención" styleClass="accent" onAction="#onNuevaAtencion">
                    <graphic><FontIcon iconLiteral="fth-clipboard"/></graphic>
                </Button>
            </VBox>
            <Label fx:id="lblHover" styleClass="odontograma-hover" StackPane.alignment="BOTTOM_LEFT">
                <StackPane.margin><Insets left="10" bottom="8"/></StackPane.margin>
            </Label>
        </StackPane>
    </center>

    <right>
        <VBox spacing="8" prefWidth="300" styleClass="odontograma-panel">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label fx:id="lblPieza" text="Inspector" styleClass="title-4"/>
            <Label fx:id="lblPiezaDetalle" text="Haga clic en una pieza para ver sus hallazgos." wrapText="true"
                   styleClass="text-muted, text-small"/>
            <ListView fx:id="lstHallazgos" VBox.vgrow="ALWAYS" styleClass="lista-ajustable"/>
            <HBox spacing="8">
                <Button fx:id="btnEliminar" text="Eliminar" styleClass="danger" onAction="#onEliminar">
                    <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                </Button>
                <Button fx:id="btnAnular" text="Anular…" onAction="#onAnular">
                    <graphic><FontIcon iconLiteral="fth-slash"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </right>

    <bottom>
        <HBox spacing="14" styleClass="odontograma-pie">
            <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Especificaciones" styleClass="text-bold"/>
                <TextArea fx:id="txtEspecificaciones" prefRowCount="2" wrapText="true"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Observaciones" styleClass="text-bold"/>
                <TextArea fx:id="txtObservaciones" prefRowCount="2" wrapText="true"/>
            </VBox>
            <VBox spacing="6" prefWidth="360" minWidth="320">
                <Label fx:id="lblEstado" wrapText="true" styleClass="text-bold"/>
                <Label fx:id="lblCpod" styleClass="text-bold"/>
                <Label fx:id="lblCeod" styleClass="text-bold"/>
                <Label fx:id="lblIntegridad" wrapText="true" styleClass="text-small"/>
                <Button fx:id="btnGuardarTextos" text="Guardar especificaciones" onAction="#onGuardarTextos">
                    <graphic><FontIcon iconLiteral="fth-save"/></graphic>
                </Button>
            </VBox>
        </HBox>
    </bottom>
</BorderPane>
