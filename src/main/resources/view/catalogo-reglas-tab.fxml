<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.odontogest.ui.controlador.ReglasTabControllerASEJ" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Para cada hallazgo se aplica la primera regla que coincide, por prioridad (menor primero)." styleClass="text-muted" wrapText="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEliminarASEJ" text="Eliminar" styleClass="danger" onAction="#onEliminarASEJ">
            <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
        </Button>
        <Button fx:id="btnEditarASEJ" text="Editar" onAction="#onEditarASEJ">
            <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
        </Button>
        <Button text="Nueva regla" styleClass="accent" onAction="#onNuevoASEJ">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>
    <TableView fx:id="tablaASEJ" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Sin registros."/></placeholder>
    </TableView>
</VBox>
