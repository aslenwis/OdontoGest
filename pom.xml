<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.odontogest</groupId>
    <artifactId>odontogest</artifactId>
    <version>1.0.0</version>
    <name>OdontoGest</name>
    <description>Gestión de consultorio odontológico con odontograma interactivo</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.4</javafx.version>
        <atlantafx.version>2.0.1</atlantafx.version>
        <ikonli.version>12.3.1</ikonli.version>
        <sqlite.version>3.45.3.0</sqlite.version>
        <openpdf.version>1.3.43</openpdf.version>
        <poi.version>5.2.5</poi.version>
        <archunit.version>1.3.0</archunit.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- RNF-10: cobertura mínima de instrucciones en el paquete dominio -->
        <cobertura.minima.dominio>0.70</cobertura.minima.dominio>
        <main.class>com.odontogest.Launcher</main.class>
        <!-- jpackage -->
        <jpackage.type>app-image</jpackage.type>  <!-- app-image | msi | exe (msi/exe requieren WiX en Windows) -->
        <jpackage.vendor>OdontoGest - Proyecto Ingeniería de Software</jpackage.vendor>
    </properties>

    <dependencies>
        <!-- Persistencia -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- Validación, correo, hash de contraseñas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JSON para integraciones (versión gestionada por Spring Boot) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Interfaz gráfica -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <!-- SwingFXUtils: convierte el snapshot del odontograma (WritableImage) a PNG para el PDF -->
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-feather-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>

        <!-- Documentos -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>odontogest</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Genera META-INF/build-info.properties → BuildProperties (versión en "Acerca de") -->
                    <execution>
                        <id>build-info</id>
                        <goals><goal>build-info</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <!-- mvn javafx:run durante el desarrollo -->
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <!-- Cobertura: mvn test genera target/site/jacoco/index.html y falla si dominio < 70 % -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>reporte</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>cobertura-dominio</id>
                        <phase>test</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <includes>
                                <include>com/odontogest/dominio/**</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.minima.dominio}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn clean package -Pempaquetar   (EJECUTAR EN WINDOWS para generar el .exe con natives de Windows) -->
        <profile>
            <id>empaquetar</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>preparar-entrada-jpackage</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/jpackage-input" quiet="true"/>
                                        <delete dir="${project.build.directory}/dist" quiet="true"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              todir="${project.build.directory}/jpackage-input"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <!-- El jpackage del JDK que ejecuta Maven: no exige tenerlo en el PATH. -->
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>${jpackage.type}</argument>
                                        <argument>--name</argument><argument>OdontoGest</argument>
                                        <argument>--app-version</argument><argument>${project.version}</argument>
                                        <argument>--vendor</argument><argument>${jpackage.vendor}</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument><argument>${project.build.finalName}.jar</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--icon</argument><argument>${project.basedir}/packaging/odontogest.ico</argument>
                                        <argument>--add-modules</argument>
                                        <argument>java.se,jdk.unsupported,jdk.crypto.ec,jdk.localedata,jdk.charsets,jdk.zipfs</argument>
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-debug --no-man-pages --no-header-files</argument>
                                        <argument>--java-options</argument><argument>-Xmx768m</argument>
                                        <argument>--java-options</argument><argument>-Dfile.encoding=UTF-8</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- ZIP final para entregar: OdontoGest/ + LEEME.txt (jar -M = ZIP sin manifiesto). -->
                            <execution>
                                <id>zip-distribucion</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jar</executable>
                                    <arguments>
                                        <argument>-cMf</argument>
                                        <argument>${project.build.directory}/dist/OdontoGest-${project.version}-windows-x64.zip</argument>
                                        <argument>-C</argument><argument>${project.build.directory}/dist</argument><argument>OdontoGest</argument>
                                        <argument>-C</argument><argument>${project.basedir}/packaging</argument><argument>LEEME.txt</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
